rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Límite de tamaño común para los adjuntos (20 MB).
    function tamanoValido() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // Adjuntos de trámites de personal. Cada quien escribe (y reemplaza/elimina)
    // únicamente en su propia carpeta. La lectura queda abierta a personal
    // autenticado porque esdomed/admin revisan adjuntos de otros y los roles
    // viven en Firestore, no en el token: aquí no se pueden verificar.
    match /tramites/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && tamanoValido();
    }

    // Documentos de impresión subidos por los médicos.
    match /impresiones/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && tamanoValido();
    }

    // Imágenes adjuntas a reportes de errores de la herramienta SIMMOW. El
    // control real de quién ve cada imagen pasa por Firestore (reportes_bugs_simmow
    // solo lo lista completo un admin, o su propio autor) — la URL nunca se
    // expone a nadie más, igual que en /tramites y /impresiones de arriba.
    match /reportes_bugs/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && tamanoValido();
    }

    // Cualquier otra ruta queda denegada.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
