rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function getRole() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data.role;
    }
    function isEsdomed()      { return isAuth() && getRole() == 'esdomed'; }
    function isMedico()       { return isAuth() && getRole() == 'medico'; }
    function isAdmin()        { return isAuth() && getRole() == 'admin'; }
    function isPsicologia()   { return isAuth() && getRole() == 'psicologia'; }
    function isTrabajoSocial(){ return isAuth() && getRole() == 'trabajo_social'; }
    function isEnfermeria()   { return isAuth() && getRole() == 'enfermeria'; }
    function isMedicoCuidadosCriticos() {
      return isMedico()
        && get(/databases/$(database)/documents/usuarios/$(uid())).data.tipoMedico in ['uci', 'ucin'];
    }
    function serviciosAsignados() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data.servicios;
    }
    function isStaff() {
      return isAuth() && getRole() in ['esdomed', 'admin', 'psicologia', 'trabajo_social'];
    }

    // ─── Usuarios ────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (necesario para
    // selects de personal y para que las reglas lean el rol).
    match /usuarios/{userId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Registros clínicos inmutables de UCI y UCIN. Los médicos solo pueden
    // registrar y consultar actividad de sus servicios asignados.
    match /atenciones_cuidados_criticos/{id} {
      allow read: if isEsdomed() || isAdmin()
                  || (isMedicoCuidadosCriticos()
                      && resource.data.servicio in serviciosAsignados());
      allow create: if isMedicoCuidadosCriticos()
                    && request.resource.data.keys().hasOnly([
                      'tipoUnidad',
                      'tipoAtencion',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'cama',
                      'fechaAtencion',
                      'resumen',
                      'detalle',
                      'medicoId',
                      'medicoNombre',
                      'medicoJvpm',
                      'creadoEn'
                    ])
                    && request.resource.data.keys().hasAll([
                      'tipoUnidad',
                      'tipoAtencion',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'fechaAtencion',
                      'resumen',
                      'medicoId',
                      'medicoNombre',
                      'creadoEn'
                    ])
                    && request.resource.data.medicoId == uid()
                    && request.resource.data.medicoNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.tipoUnidad == get(/databases/$(database)/documents/usuarios/$(uid())).data.tipoMedico
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Ficha estructurada que reemplaza la fila de la matriz en Drive. Puede
    // completarse por partes; cada guardado conserva autor y fecha de edición.
    match /fichas_cuidados_criticos/{id} {
      allow read: if isEsdomed() || isAdmin()
                  || (isMedicoCuidadosCriticos()
                      && resource.data.servicio in serviciosAsignados());
      allow create: if isMedicoCuidadosCriticos()
                    && request.resource.data.keys().hasOnly([
                      'tipoUnidad',
                      'estadoEstancia',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'cama',
                      'datos',
                      'creadoPorId',
                      'creadoPorNombre',
                      'creadoEn',
                      'actualizadoPorId',
                      'actualizadoPorNombre',
                      'actualizadoEn'
                    ])
                    && request.resource.data.tipoUnidad == get(/databases/$(database)/documents/usuarios/$(uid())).data.tipoMedico
                    && request.resource.data.estadoEstancia in ['activa', 'egresada']
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.creadoPorId == uid()
                    && request.resource.data.creadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.actualizadoPorId == uid()
                    && request.resource.data.actualizadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.creadoEn == request.time
                    && request.resource.data.actualizadoEn == request.time;
      allow update: if isMedicoCuidadosCriticos()
                    && resource.data.servicio in serviciosAsignados()
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.pacienteId == resource.data.pacienteId
                    && request.resource.data.tipoUnidad == resource.data.tipoUnidad
                    && request.resource.data.estadoEstancia in ['activa', 'egresada']
                    && request.resource.data.servicio == resource.data.servicio
                    && request.resource.data.creadoPorId == resource.data.creadoPorId
                    && request.resource.data.creadoPorNombre == resource.data.creadoPorNombre
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoPorId == uid()
                    && request.resource.data.actualizadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.actualizadoEn == request.time;
      allow delete: if isAdmin();
    }

    // ─── Traslados ────────────────────────────────────────────────────────────
    match /traslados/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Notificaciones de fallecidos ─────────────────────────────────────────
    match /notificaciones_fallecidos/{id} {
      allow read:   if isAuth() && (isStaff() || isPsicologia() || isTrabajoSocial() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff() || isPsicologia() || isTrabajoSocial();
      allow delete: if isAdmin();
    }

    // ─── Solicitudes de impresión ─────────────────────────────────────────────
    match /solicitudes_impresion/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Pacientes ────────────────────────────────────────────────────────────
    match /pacientes/{id} {
      allow read:   if isStaff() || isMedico() || isEnfermeria();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Personas ─────────────────────────────────────────────────────────────
    // Datos personales canónicos del paciente (clave = expediente). Mismo acceso
    // que pacientes: el personal los consulta y ESDOMED/admin los crean y editan.
    match /personas/{expediente} {
      allow read:   if isStaff() || isMedico() || isEnfermeria();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Control de ingresos ──────────────────────────────────────────────────
    // Los médicos tienen acceso de solo lectura para ver la cola.
    // Solo el personal ESDOMED puede registrar ingresos.
    match /busquedas_telefono/{id} {
      allow read: if isAdmin();
      allow create: if isMedico()
                    && request.resource.data.keys().hasOnly([
                      'usuarioUid',
                      'usuarioNombre',
                      'usuarioEmail',
                      'usuarioRole',
                      'usuarioJvpm',
                      'expedienteBuscado',
                      'expedienteNormalizado',
                      'encontrado',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'pacienteEstado',
                      'pacienteServicio',
                      'pacienteCama',
                      'creadoEn'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioUid',
                      'usuarioNombre',
                      'usuarioRole',
                      'expedienteBuscado',
                      'expedienteNormalizado',
                      'encontrado',
                      'creadoEn'
                    ])
                    && request.resource.data.usuarioUid == uid()
                    && request.resource.data.usuarioRole == 'medico'
                    && request.resource.data.usuarioNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.expedienteBuscado is string
                    && request.resource.data.expedienteNormalizado is string
                    && request.resource.data.encontrado is bool
                    && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    match /control_ingresos/{id} {
      allow read:   if isAuth();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Incapacidades ────────────────────────────────────────────────────────
    match /incapacidades/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow delete: if isAdmin();
    }

    // ─── Recepciones (psicología / trabajo social) ────────────────────────────
    match /recepciones/{id} {
      allow read:   if isStaff() || isPsicologia() || isTrabajoSocial();
      allow create: if isPsicologia() || isTrabajoSocial() || isEsdomed();
      allow update: if isPsicologia() || isTrabajoSocial() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Notificaciones de altas vivos ───────────────────────────────────────
    match /notificaciones_altas/{id} {
      // Enfermería, TS y ESDOMED pueden leer todas.
      allow read:   if isEnfermeria() || isTrabajoSocial() || isEsdomed() || isAdmin();
      // Enfermería y TS pueden crear.
      allow create: if isEnfermeria() || isTrabajoSocial();
      // TS puede editar solo las que siguen pendientes (cambiar tipo, archivar).
      // ESDOMED puede marcar como procesada (también solo si está pendiente).
      allow update: if (isTrabajoSocial() || isEsdomed() || isAdmin())
                    && (resource.data.estado == 'pendiente' || resource.data.estado == 'observada');
      allow delete: if isAdmin();
    }

    // ─── Anexo 5 ──────────────────────────────────────────────────────────────
    match /anexo5/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Configuración global ────────────────────────────────────────────────
    // Servicios y camas: lectura pública (no es dato sensible), escritura solo admin.
    match /configuracion/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
