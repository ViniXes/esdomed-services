rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function getRole() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data.role;
    }
    // El auxiliar administrativo ESDOMED (asistente_esdomed) comparte los mismos
    // permisos operativos que ESDOMED; por eso se incluye aquí. El superusuario
    // (admin) sigue siendo aparte y con privilegios más profundos.
    function isEsdomed()      { return isAuth() && getRole() in ['esdomed', 'asistente_esdomed']; }
    function isAsistenteEsdomed() { return isAuth() && getRole() == 'asistente_esdomed'; }
    function isMedico()       { return isAuth() && getRole() == 'medico'; }
    function isAdmin()        { return isAuth() && getRole() == 'admin'; }
    function isPsicologia()   { return isAuth() && getRole() == 'psicologia'; }
    function isTrabajoSocial(){ return isAuth() && getRole() == 'trabajo_social'; }
    function isEnfermeria()   { return isAuth() && getRole() == 'enfermeria'; }
    function isRrhh()         { return isAuth() && getRole() == 'rrhh'; }
    function isTransporte()   { return isAuth() && getRole() == 'transporte'; }
    function isMotorista()    { return isAuth() && getRole() == 'motorista'; }
    // Roles del módulo Convenio ISBM. Sus datos viven en Supabase; en Firestore
    // solo LEEN el padrón (pacientes/personas) para afiliar — nunca escriben.
    function isIsbm()         { return isAuth() && getRole() in ['isbm_tecnico', 'isbm_supervisor', 'isbm_jefe']; }
    // Sesión real (no anónima). El formulario público de transporte usa sesiones
    // anónimas: NO deben poder leer datos internos del portal.
    function isRealUser() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isMedicoCuidadosCriticos() {
      return isMedico()
        && get(/databases/$(database)/documents/usuarios/$(uid())).data.tipoMedico in ['uci', 'ucin', 'uci_ucin', 'jefe_uci_ucin'];
    }
    function tipoMedicoCritico() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data.tipoMedico;
    }
    function isJefeCuidadosCriticos() {
      return isMedico() && tipoMedicoCritico() == 'jefe_uci_ucin';
    }
    function puedeRegistrarTipoUnidad(tipoUnidad) {
      return tipoMedicoCritico() == tipoUnidad
        || (tipoMedicoCritico() in ['uci_ucin', 'jefe_uci_ucin'] && tipoUnidad in ['uci', 'ucin']);
    }
    function serviciosAsignados() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data.servicios;
    }
    function isStaff() {
      return isAuth() && getRole() in ['esdomed', 'asistente_esdomed', 'admin', 'psicologia', 'trabajo_social'];
    }

    // ─── Usuarios ────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (necesario para
    // selects de personal y para que las reglas lean el rol).
    match /usuarios/{userId} {
      // Sesiones anónimas: solo pueden intentar leer su propio doc (no existe),
      // necesario para que el AuthContext resuelva "sin perfil" sin error.
      allow read:   if isRealUser() || (isAuth() && uid() == userId);
      allow create: if isAdmin();
      // El admin puede actualizar cualquier campo. Además, cada usuario puede
      // registrar SOLO su propia aceptación de términos (generales y/o los
      // específicos de la herramienta SIMMOW).
      allow update: if isAdmin()
        || (isAuth() && uid() == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['terminosAceptados', 'terminosSimmowAceptados']));
      allow delete: if isAdmin();
    }

    // ─── Autoregistro de médicos (solicitudes pendientes) ─────────────────────
    // El alta la hace el endpoint público /api/registro-medico con Admin SDK
    // (que ignora estas reglas); aquí solo permitimos que el admin las lea y
    // gestione desde el dashboard. Ningún rol puede escribir directamente.
    match /registros_medicos_pendientes/{uid} {
      allow read:   if isAdmin();
      allow write:  if false;
    }
    // Historial de resoluciones (aprobado/rechazado). Lo escribe el Admin SDK; el
    // admin solo lo consulta desde el dashboard.
    match /registros_medicos_historial/{id} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    // Registros clínicos inmutables de UCI y UCIN. Los médicos solo pueden
    // registrar y consultar actividad de sus servicios asignados.
    match /atenciones_cuidados_criticos/{id} {
      allow read: if isAdmin()
                  || (isMedicoCuidadosCriticos()
                      && resource.data.servicio in serviciosAsignados());
      allow create: if isMedicoCuidadosCriticos()
                    && request.resource.data.keys().hasOnly([
                      'tipoUnidad',
                      'tipoAtencion',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'cama',
                      'fechaAtencion',
                      'resumen',
                      'detalle',
                      'medicoId',
                      'medicoNombre',
                      'medicoJvpm',
                      'creadoEn'
                    ])
                    && request.resource.data.keys().hasAll([
                      'tipoUnidad',
                      'tipoAtencion',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'fechaAtencion',
                      'resumen',
                      'medicoId',
                      'medicoNombre',
                      'creadoEn'
                    ])
                    && request.resource.data.medicoId == uid()
                    && request.resource.data.medicoNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && puedeRegistrarTipoUnidad(request.resource.data.tipoUnidad)
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Ficha estructurada que reemplaza la fila de la matriz en Drive. Puede
    // completarse por partes; cada guardado conserva autor y fecha de edición.
    match /fichas_cuidados_criticos/{id} {
      allow read: if isAdmin()
                  || (isMedicoCuidadosCriticos()
                      && resource.data.servicio in serviciosAsignados());
      allow create: if isMedicoCuidadosCriticos()
                    && request.resource.data.keys().hasOnly([
                      'tipoUnidad',
                      'estadoEstancia',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'servicio',
                      'cama',
                      'datos',
                      'creadoPorId',
                      'creadoPorNombre',
                      'creadoEn',
                      'actualizadoPorId',
                      'actualizadoPorNombre',
                      'actualizadoEn'
                    ])
                    && puedeRegistrarTipoUnidad(request.resource.data.tipoUnidad)
                    && request.resource.data.estadoEstancia in ['activa', 'egresada']
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.creadoPorId == uid()
                    && request.resource.data.creadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.actualizadoPorId == uid()
                    && request.resource.data.actualizadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.creadoEn == request.time
                    && request.resource.data.actualizadoEn == request.time;
      allow update: if isAdmin()
                    || (isMedicoCuidadosCriticos()
                    && resource.data.servicio in serviciosAsignados()
                    && request.resource.data.servicio in serviciosAsignados()
                    && request.resource.data.pacienteId == resource.data.pacienteId
                    && puedeRegistrarTipoUnidad(request.resource.data.tipoUnidad)
                    && request.resource.data.estadoEstancia in ['activa', 'egresada']
                    && request.resource.data.creadoPorId == resource.data.creadoPorId
                    && request.resource.data.creadoPorNombre == resource.data.creadoPorNombre
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoPorId == uid()
                    && request.resource.data.actualizadoPorNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.actualizadoEn == request.time);
      // Admin puede eliminar cualquier ficha directamente, o al aprobar una
      // solicitudEliminacion enviada por el médico autor (ver update arriba).
      allow delete: if isAdmin();
    }

    // ─── Traslados ────────────────────────────────────────────────────────────
    // Configuracion mensual usada para indicadores UCI/UCIN.
    // No se deriva de camas clinicas porque el dato estadistico puede cambiar por periodo.
    match /config_indicadores_cuidados_criticos/{id} {
      allow read: if isAdmin() || isJefeCuidadosCriticos();
      allow create, update, delete: if isAdmin();
    }

    match /traslados/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      // El staff gestiona el estado; el médico puede corregir y reenviar su propio
      // traslado solo cuando ESDOMED lo dejó en revisión.
      allow update: if isStaff()
                    || (isMedico() && resource.data.medicoId == uid()
                        && resource.data.estado == 'en_revision');
      allow delete: if isAdmin();
    }

    // ─── Traslado a otro hospital (referencia externa) ────────────────────────
    // El médico solo notifica; ESDOMED (staff) confirma de recibido. Sin flujo
    // de edición del médico.
    match /traslados_externos/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Notificaciones de fallecidos ─────────────────────────────────────────
    // Delete: ESDOMED puede eliminar notificaciones duplicadas, pero NO las de
    // trámite cerrado (esas solo el admin, previa revisión).
    match /notificaciones_fallecidos/{id} {
      allow read:   if isAuth() && (isStaff() || isPsicologia() || isTrabajoSocial() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff() || isPsicologia() || isTrabajoSocial();
      allow delete: if isAdmin()
                    || (isEsdomed() && resource.data.tramiteCerrado != true);
    }

    // ─── Reportes de errores de la herramienta SIMMOW ─────────────────────────
    // Reporte técnico (no un reclamo formal) que sustenta la cláusula de
    // "reportado y confirmado" de los términos de uso de la herramienta
    // (ver src/lib/simmow/terminosSimmow.ts). Solo un admin puede marcarlo
    // confirmado/no-es-error; quien lo crea no puede alterar su propio reporte.
    match /reportes_bugs_simmow/{id} {
      // El listado completo (con la descripción, el expediente y ahora las
      // imágenes adjuntas de cada reporte) es solo para admin: el personal de
      // ESDOMED reporta el error, pero no tiene por qué ver reportes ajenos ni
      // el detalle del propio. Sí puede leer SU PROPIO reporte (resource.data.uid
      // == uid()) para consultar si ya se resolvió — una consulta filtrada por
      // "uid == su propio uid" es la única forma de listar bajo esta regla.
      // create: SIMMOW es solo para el rol esdomed puntual + admin (no
      // asistente_esdomed), a diferencia de isEsdomed() que sí lo agrupa.
      allow read:   if isAdmin() || (isAuth() && resource.data.uid == uid());
      allow create: if (getRole() == 'esdomed' || isAdmin()) && request.resource.data.uid == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Solicitudes de impresión ─────────────────────────────────────────────
    match /solicitudes_impresion/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Pacientes ────────────────────────────────────────────────────────────
    match /pacientes/{id} {
      allow read:   if isStaff() || isMedico() || isEnfermeria() || isIsbm();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Personas ─────────────────────────────────────────────────────────────
    // Datos personales canónicos del paciente (clave = expediente). Mismo acceso
    // que pacientes: el personal los consulta y ESDOMED/admin los crean y editan.
    match /personas/{expediente} {
      allow read:   if isStaff() || isMedico() || isEnfermeria() || isIsbm();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Hospital Día ─────────────────────────────────────────────────────────
    // Pacientes crónicos a los que solo se les crea el expediente. Marcador +
    // lista del módulo (docId = expediente). Solo ESDOMED/admin. La persona
    // canónica se crea en /personas (que ya permite escritura a ESDOMED/admin).
    match /hospital_dia/{expediente} {
      allow read:   if isEsdomed() || isAdmin();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Atendidos en Emergencia ──────────────────────────────────────────────
    // Atenciones de emergencia importadas del reporte del SIS. Módulo aparte de
    // pacientes. Consulta: personal + médicos (solo lectura). Importación: solo
    // ESDOMED/admin. No escribe en personas/pacientes.
    match /atenciones_emergencia/{id} {
      allow read:   if isStaff() || isMedico();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isEsdomed() || isAdmin();
    }

    // ─── Control de ingresos ──────────────────────────────────────────────────
    // Los médicos tienen acceso de solo lectura para ver la cola.
    // Solo el personal ESDOMED puede registrar ingresos.
    match /busquedas_telefono/{id} {
      allow read: if isAdmin();
      allow create: if isMedico()
                    && request.resource.data.keys().hasOnly([
                      'usuarioUid',
                      'usuarioNombre',
                      'usuarioEmail',
                      'usuarioRole',
                      'usuarioJvpm',
                      'expedienteBuscado',
                      'expedienteNormalizado',
                      'encontrado',
                      'pacienteId',
                      'pacienteExpediente',
                      'pacienteNombre',
                      'pacienteEstado',
                      'pacienteServicio',
                      'pacienteCama',
                      'creadoEn'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioUid',
                      'usuarioNombre',
                      'usuarioRole',
                      'expedienteBuscado',
                      'expedienteNormalizado',
                      'encontrado',
                      'creadoEn'
                    ])
                    && request.resource.data.usuarioUid == uid()
                    && request.resource.data.usuarioRole == 'medico'
                    && request.resource.data.usuarioNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.expedienteBuscado is string
                    && request.resource.data.expedienteNormalizado is string
                    && request.resource.data.encontrado is bool
                    && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // ─── Consultas de ficha de paciente (auditoría "Buscar Paciente") ─────────
    // Médicos, trabajo social, psicología y ESDOMED dejan constancia al abrir la
    // ficha rápida de un paciente. Solo admin puede leer el historial; los
    // registros son inmutables.
    match /consultas_paciente/{id} {
      allow read: if isAdmin();
      allow create: if isAuth()
                    && (isMedico() || isTrabajoSocial() || isPsicologia() || isEsdomed() || isAdmin())
                    && request.resource.data.usuarioUid == uid()
                    && request.resource.data.usuarioNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre
                    && request.resource.data.criterio in ['expediente', 'dui', 'nombre']
                    && request.resource.data.termino is string
                    && request.resource.data.expedienteConsultado is string
                    && request.resource.data.tieneIngresoActivo is bool
                    && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    match /control_ingresos/{id} {
      allow read:   if isRealUser();
      allow create: if isEsdomed() || isAdmin();
      allow update: if isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Censos de Emergencia ─────────────────────────────────────────────────
    // Digitan los médicos de emergencia (rol medico); ESDOMED supervisa.
    match /censo_demanda_espontanea/{id} {
      allow read:   if isMedico() || isEsdomed() || isAdmin();
      allow create: if (isMedico() || isEsdomed() || isAdmin())
                    && request.resource.data.creadoPorId == uid();
      allow update: if isMedico() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    match /censo_referidos/{id} {
      allow read:   if isMedico() || isEsdomed() || isAdmin();
      allow create: if (isMedico() || isEsdomed() || isAdmin())
                    && request.resource.data.creadoPorId == uid();
      allow update: if isMedico() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Incapacidades ────────────────────────────────────────────────────────
    match /incapacidades/{id} {
      // Lectura pública para el cuerpo médico: cualquier médico (o staff) puede ver
      // todas las incapacidades (vista pública en /medico/incapacidades). La edición
      // y el borrado siguen restringidos al dueño (o staff/admin).
      allow read:   if isAuth() && (isStaff() || isMedico());
      allow create: if isMedico();
      allow update: if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      // ESDOMED/admin pueden borrar cualquiera; el médico solo las propias y
      // mientras sigan pendientes (p. ej. para quitar un duplicado).
      allow delete: if isEsdomed() || isAdmin()
                    || (isMedico() && resource.data.medicoId == uid()
                        && resource.data.estado == 'pendiente');
    }

    // ─── Recepciones (psicología / trabajo social) ────────────────────────────
    match /recepciones/{id} {
      allow read:   if isStaff() || isPsicologia() || isTrabajoSocial();
      allow create: if isPsicologia() || isTrabajoSocial() || isEsdomed();
      allow update: if isPsicologia() || isTrabajoSocial() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Notificaciones de altas vivos ───────────────────────────────────────
    match /notificaciones_altas/{id} {
      // Enfermería, TS, Psicología y ESDOMED pueden leer (Psicología solo consulta el informe).
      allow read:   if isEnfermeria() || isTrabajoSocial() || isPsicologia() || isEsdomed() || isAdmin();
      // Enfermería y TS pueden crear.
      allow create: if isEnfermeria() || isTrabajoSocial();
      // TS puede editar solo las que siguen pendientes (cambiar tipo, archivar).
      // ESDOMED puede marcar como procesada (también solo si está pendiente).
      allow update: if (isTrabajoSocial() || isEsdomed() || isAdmin())
                    && (resource.data.estado == 'pendiente' || resource.data.estado == 'observada');
      allow delete: if isAdmin();
    }

    // ─── Notificación de Altas / pre-altas (log interno de Trabajo Social) ────
    // Registro diario de pacientes notificados de alta. Control interno de TS.
    match /notificaciones_prealta/{id} {
      // Enfermería tiene acceso SOLO de lectura (ver e imprimir el reporte); no crea/edita.
      allow read:   if isTrabajoSocial() || isEsdomed() || isEnfermeria() || isAdmin();
      allow create: if isTrabajoSocial() || isAdmin();
      allow update: if isTrabajoSocial() || isAdmin();
      allow delete: if isTrabajoSocial() || isAdmin();
    }

    // ─── Visitas de familiares (Trabajo Social) ───────────────────────────────
    // Tarjeta por paciente (con lista blanca) y registro de entradas/salidas.
    // Gestionado por Trabajo Social; ESDOMED/admin con acceso de supervisión.
    match /tarjetas_visita/{id} {
      allow read:   if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow create: if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow update: if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }
    match /visitas/{id} {
      allow read:   if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow create: if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow update: if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Gestiones de Trabajo Social (UTS) ────────────────────────────────────
    // Registro transversal de intervenciones (reemplazo del Google Form). Cada
    // trabajadora crea y administra las propias; ESDOMED/admin leen para reportes.
    match /gestiones_ts/{id} {
      allow read:   if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow create: if (isTrabajoSocial() || isAdmin())
                    && request.resource.data.trabajadoraId == uid()
                    && request.resource.data.trabajadoraNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre;
      allow update: if isAdmin()
                    || (isTrabajoSocial() && resource.data.trabajadoraId == uid());
      allow delete: if isAdmin()
                    || (isTrabajoSocial() && resource.data.trabajadoraId == uid());
    }

    // Rastreo de pacientes (paso 0 de Trabajo Social). Worklist compartida: cualquier
    // trabajadora social puede crear/actualizar, sellándose como última en tocarlo.
    match /rastreos_ts/{id} {
      allow read:   if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow create, update: if (isTrabajoSocial() || isAdmin())
                    && request.resource.data.trabajadoraId == uid()
                    && request.resource.data.trabajadoraNombre == get(/databases/$(database)/documents/usuarios/$(uid())).data.nombre;
      allow delete: if isAdmin();
    }

    // Tableros resumen de Trabajo Social (1 doc por tablero: ts_resumen/rastreo,
    // ts_resumen/seguimiento-YYYY-MM). Optimización de lecturas: las vistas leen
    // el tablero completo con 1 lectura; el doc se actualiza en el MISMO batch
    // que el detalle (rastreos_ts / gestiones_ts), por cualquier trabajadora.
    match /ts_resumen/{id} {
      allow read:   if isTrabajoSocial() || isEsdomed() || isAdmin();
      allow create, update: if isTrabajoSocial() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Transporte institucional ─────────────────────────────────────────────
    // La solicitud entra por un formulario PÚBLICO con sesión anónima: create
    // acepta cualquier sesión pero valida la forma del documento y sella el
    // solicitanteUid. El docId es el FOLIO (código no adivinable): conocerlo
    // equivale a poder consultar ESA solicitud (get); listar es solo del área.
    match /viajes_transporte/{folio} {
      allow get:  if isAuth();
      allow list: if isTransporte() || isMotorista() || isAdmin();
      allow create: if isAuth()
        && request.resource.data.folio == folio
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.solicitanteUid == uid()
        && request.resource.data.solicitanteNombre is string
        && request.resource.data.solicitanteNombre.size() >= 5
        && request.resource.data.solicitanteNombre.size() <= 120
        && request.resource.data.solicitanteDui is string
        && request.resource.data.solicitanteDui.size() <= 15
        && request.resource.data.solicitanteCodigoEmpleado is string
        && request.resource.data.solicitanteCodigoEmpleado.size() <= 30
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 80
        && request.resource.data.mision is string
        && request.resource.data.mision.size() >= 5
        && request.resource.data.mision.size() <= 600
        && request.resource.data.destinoTexto is string
        && request.resource.data.destinoTexto.size() >= 3
        && request.resource.data.destinoTexto.size() <= 300
        && request.resource.data.fechaNecesita is string
        && request.resource.data.horaNecesita is string;
      // Jefe/admin gestionan; el motorista solo toca viajes asignados a él.
      allow update: if isTransporte() || isAdmin()
        || (isMotorista() && resource.data.motoristaId == uid());
      allow delete: if isAdmin();
    }

    match /vehiculos_transporte/{id} {
      allow read:   if isTransporte() || isMotorista() || isAdmin();
      allow create: if isTransporte() || isAdmin();
      // El motorista actualiza el kilometraje del vehículo al cerrar un viaje.
      allow update: if isTransporte() || isMotorista() || isAdmin();
      allow delete: if isAdmin();
    }

    // Checklist diario por vehículo (requisito para iniciar ruta); cada motorista
    // crea y corrige solo los propios.
    match /checklists_vehiculo/{id} {
      allow read:   if isTransporte() || isMotorista() || isAdmin();
      allow create: if (isTransporte() || isMotorista() || isAdmin())
        && request.resource.data.motoristaId == uid();
      allow update: if isAdmin()
        || ((isTransporte() || isMotorista()) && resource.data.motoristaId == uid());
      allow delete: if isAdmin();
    }

    // ─── Anexo 5 ──────────────────────────────────────────────────────────────
    match /anexo5/{id} {
      allow read:   if isAuth() && (isStaff() || (isMedico() && resource.data.medicoId == uid()));
      allow create: if isMedico();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Recursos Humanos: empleados y licencias ──────────────────────────────
    // Datos sensibles del personal (NIT, ISSS, salarios, incapacidades). Acceso
    // EXCLUSIVO de RRHH y admin; ningún otro rol (médicos, ESDOMED, etc.) los ve.
    match /empleados/{codigo} {
      allow read:   if isRrhh() || isAdmin();
      allow create: if isRrhh() || isAdmin();
      allow update: if isRrhh() || isAdmin();
      allow delete: if isAdmin();
    }
    match /licencias/{id} {
      allow read:   if isRrhh() || isAdmin();
      allow create: if isRrhh() || isAdmin();
      allow update: if isRrhh() || isAdmin();
      allow delete: if isRrhh() || isAdmin();
    }

    // Planes de trabajo (horarios mensuales) de ESDOMED. No son datos sensibles
    // del personal: cualquier miembro de ESDOMED puede consultar su horario; solo
    // el asistente administrativo y admin pueden crear/editar el plan.
    match /planes_trabajo/{periodo} {
      allow read:   if isEsdomed() || isAsistenteEsdomed() || isAdmin();
      allow create: if isAsistenteEsdomed() || isAdmin();
      allow update: if isAsistenteEsdomed() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Trámites de Personal ─────────────────────────────────────────────────
    // Los empleados pueden crear y leer sus propios trámites.
    // Administración / Esdomed pueden leer todos y actualizarlos (para aprobar/rechazar).
    match /tramites_personal/{id} {
      allow read:   if isAuth() && (resource.data.empleadoId == uid() || isEsdomed() || isAsistenteEsdomed() || isAdmin());
      allow create: if isAuth() && request.resource.data.empleadoId == uid();
      // Revisores resuelven cualquier trámite; el dueño puede editar el suyo en
      // cualquier momento (también ya resuelto) sin tocar los campos de revisión
      // ni auto-aprobarse: una edición siempre vuelve a 'subido' o 'pendiente'.
      allow update: if isEsdomed() || isAsistenteEsdomed() || isAdmin()
        || (
          isAuth()
          && resource.data.empleadoId == uid()
          && request.resource.data.empleadoId == resource.data.empleadoId
          && request.resource.data.estado in ['subido', 'pendiente']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'categoria', 'notas', 'fechaInicio', 'fechaFin', 'horas', 'tipoSolicitud',
            'documentoUrl', 'documentoNombre', 'documentos', 'estado', 'actualizadoEn'
          ])
        );
      allow delete: if isAdmin();
    }

    // ─── Configuración global ────────────────────────────────────────────────
    // Servicios y camas: lectura pública (no es dato sensible), escritura solo admin.
    match /configuracion/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
